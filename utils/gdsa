#!/usr/bin/env bash
# gdsa — sds-agent launcher
#
# Adapted from darribas/gds_env's utils/gdsa (BSD-3-Clause) for the SDS
# teaching image. Runs Claude Code, opencode, or GitHub Copilot CLI in a
# throwaway container built from frontend_agent/Dockerfile, with your
# terminal attached directly (docker/podman run -it) -- no server, no
# socket, just a CLI process running inside the container.
#
# Usage:
#   gdsa claude    [opts] [path]  Run Claude Code CLI in path (default $PWD)
#   gdsa opencode  [opts] [path]  Run opencode, Ollama/OpenAI-compatible-wired
#   gdsa copilot   [opts] [path]  Run GitHub Copilot CLI in path
#   gdsa shell     [path]         Interactive bash in path, no harness
#   gdsa update                   Replace this launcher with a fresh copy
#                                 from the repo
#   gdsa help                     Print this message
#
# Options (claude / opencode / copilot):
#   --with-git-creds, -git
#                  Mount your git/GitHub credentials into the container:
#                  ~/.ssh (ro), ~/.config/gh (rw), and GITHUB_TOKEN / GH_TOKEN
#                  if set. OFF BY DEFAULT: the harnesses run with
#                  --dangerously-skip-permissions / --allow-all, so an agent
#                  pointed at an untrusted repo has no push-capable secrets to
#                  leak unless you ask for them. Pass it when you want the
#                  agent to push, open PRs, or use gh.
#                  A sanitized copy of ~/.gitconfig (name/email only) is
#                  always mounted, not the raw file -- the raw file can
#                  carry credential.helper, url.<>.insteadOf rewrites, or
#                  http.extraHeader, none of which are safe to hand an
#                  agent running with permission checks disabled just to
#                  get its author identity right.
#
# Env overrides:
#   GDSA_RUNTIME   Container CLI to use: docker or podman (default: podman)
#   GDSA_IMAGE     Image tag to run (default: jreades/sds-agent:latest)
#   OLLAMA_HOST    Ollama endpoint, bare host:port, no scheme (wins over
#                  provider-url.txt) — same format Ollama's own CLI uses
#   OPENAI_HOST    Optional second, OpenAI-compatible endpoint, bare host:port,
#                  no scheme (wins over openai-provider-url.txt). Independent
#                  of OLLAMA_HOST — may point at a different machine.

set -euo pipefail

RUNTIME="${GDSA_RUNTIME:-podman}"
IMAGE="${GDSA_IMAGE:-jreades/sds-agent:latest}"
CONTAINER_HOME="/home/jovyan"
WORKDIR="${CONTAINER_HOME}/work"

# Resolve script dir portably (Linux + macOS). BSD readlink lacks -f.
_resolve_script_dir() {
  local source="${BASH_SOURCE[0]:-$0}" dir
  while [ -L "$source" ]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ $source != /* ]] && source="$dir/$source"
  done
  cd -P "$(dirname "$source")" && pwd
}
SCRIPT_DIR="$(_resolve_script_dir)"

#--- Option parsing -----------------------------------------------------------

# Credentials are opt-in for the agent subcommands. Consumes any leading
# options, then the optional path; sets WITH_GIT_CREDS and AGENT_PATH.
WITH_GIT_CREDS=0
AGENT_PATH=""

_parse_agent_opts() {
  WITH_GIT_CREDS=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --with-git-creds|-git) WITH_GIT_CREDS=1; shift ;;
      --) shift; break ;;
      -*) _die "unknown option: $1 (see 'gdsa help')" ;;
      *) break ;;
    esac
  done
  AGENT_PATH="${1:-$PWD}"
}

#--- Helpers ------------------------------------------------------------------

# Colors only when stdout is a TTY.
if [ -t 1 ]; then
  C_YELLOW=$'\033[33m'
  C_RED=$'\033[31m'
  C_DIM=$'\033[2m'
  C_RESET=$'\033[0m'
else
  C_YELLOW=''; C_RED=''; C_DIM=''; C_RESET=''
fi

_die()  { echo "${C_RED}gdsa: error:${C_RESET} $*" >&2; exit 1; }
_warn() { echo "${C_YELLOW}gdsa: heads up:${C_RESET} $*" >&2; }
_hint() { echo "${C_DIM}         $*${C_RESET}" >&2; }

# Central cleanup: temp files (e.g. the sanitized gitconfig) and background
# PIDs (e.g. opencode's keep-alive loop) register themselves here instead of
# each subcommand managing its own trap, so nothing is skipped regardless of
# which subcommand runs or how it exits. None of the subcommands below use
# `exec` for exactly this reason -- exec replaces the process image without
# running EXIT traps, which would silently skip this cleanup.
CLEANUP_FILES=()
CLEANUP_PIDS=()
_cleanup() {
  local f pid
  for f in ${CLEANUP_FILES[@]+"${CLEANUP_FILES[@]}"}; do
    rm -f "$f" 2>/dev/null || true
  done
  for pid in ${CLEANUP_PIDS[@]+"${CLEANUP_PIDS[@]}"}; do
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  done
}
trap _cleanup EXIT INT TERM

_usage() {
  # Print the header comment block: line 2 through the first non-comment line.
  awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
}

# Append `-v src:dst[:mode]` to MOUNTS only if src exists on host.
MOUNTS=()
_mount_if_exists() {
  local src="$1" dst="$2" mode="${3:-rw}"
  if [ -e "$src" ]; then
    MOUNTS+=(-v "${src}:${dst}:${mode}")
  fi
}

# Append `-e VAR` to ENVS only if VAR is set in the host env.
ENVS=()
_env_if_set() {
  local var="$1"
  if [ -n "${!var:-}" ]; then
    ENVS+=(-e "${var}")
  fi
}

# Writes a throwaway ~/.gitconfig containing only [user] name/email
# (identity, so commits made in the container carry the right author) and
# registers it for cleanup. The real ~/.gitconfig is not mounted: it can
# carry credential.helper, url.<>.insteadOf rewrites, or http.extraHeader,
# any of which would hand an agent running with permission checks disabled
# something it could use to push or authenticate, not just an author name.
_sanitized_gitconfig() {
  local name email tmp
  name=$(git config --global --get user.name 2>/dev/null || true)
  email=$(git config --global --get user.email 2>/dev/null || true)
  [ -z "$name" ] && [ -z "$email" ] && return 0
  tmp=$(mktemp)
  {
    echo "[user]"
    [ -n "$name" ]  && printf '\tname = %s\n' "$name"
    [ -n "$email" ] && printf '\temail = %s\n' "$email"
  } > "$tmp"
  CLEANUP_FILES+=("$tmp")
  echo "$tmp"
}

# Mount the always-on set: sanitized gitconfig + ssh, read-only.
_mount_common() {
  local sanitized
  sanitized=$(_sanitized_gitconfig)
  [ -n "$sanitized" ] && \
    MOUNTS+=(-v "${sanitized}:${CONTAINER_HOME}/.gitconfig:ro")
  # SSH keys are a credential: opt-in for agents, always on for `gdsa shell`,
  # which sets WITH_GIT_CREDS itself.
  [ "$WITH_GIT_CREDS" = "1" ] && \
    _mount_if_exists "$HOME/.ssh" "${CONTAINER_HOME}/.ssh" ro
  return 0
}

# The GitHub half of the credential set: gh's config plus any token env vars.
# Called by the agent subcommands after _mount_common.
_mount_git_creds() {
  if [ "$WITH_GIT_CREDS" != "1" ]; then
    _hint "git/GitHub credentials not mounted. Pass --with-git-creds (-git) if the agent needs to push or use gh."
    return 0
  fi
  mkdir -p "$HOME/.config/gh"
  _mount_if_exists "$HOME/.config/gh" "${CONTAINER_HOME}/.config/gh" rw
  _env_if_set GITHUB_TOKEN
  _env_if_set GH_TOKEN
  return 0
}

#--- Preflight ----------------------------------------------------------------
# Warn (don't block) about missing host-side files so the user knows what to
# fix without having to read this script. Each harness layers its own checks
# on top of the common ones.

_preflight_common() {
  if [ ! -f "$HOME/.gitconfig" ]; then
    _warn "no ~/.gitconfig found — commits inside the container will use a default identity."
    _hint "fix: git config --global user.name 'Your Name'"
    _hint "     git config --global user.email 'you@example.com'"
  fi
  if [ ! -d "$HOME/.ssh" ]; then
    _warn "no ~/.ssh/ found — git push over SSH won't work from the container."
    _hint "fix: ssh-keygen -t ed25519 -C 'you@example.com'"
  fi
}

_preflight_claude() {
  if [ ! -f "$HOME/.claude.json" ] && [ ! -d "$HOME/.claude" ]; then
    _warn "no Claude Code auth at ~/.claude.json or ~/.claude/ — first run will prompt you to log in."
    _hint "auth persists to ~/.claude.json + ~/.claude/ across container runs."
  fi
  _ensure_gh_auth
}

# Ensure ~/.config/gh/hosts.yml exists (i.e. gh is authenticated on the host).
# Falls back to running gh auth login inside the container if gh is not on the host PATH.
_ensure_gh_auth() {
  # Pointless when the creds will not be mounted -- it would authenticate a
  # host config the container never sees.
  [ "$WITH_GIT_CREDS" = "1" ] || return 0
  [ -f "$HOME/.config/gh/hosts.yml" ] && return 0

  mkdir -p "$HOME/.config/gh"

  echo "gdsa: GitHub CLI is not authenticated (no ~/.config/gh/hosts.yml)."
  printf '%s' "gdsa: run 'gh auth login' now? [Y/n] "
  read -r _reply
  case "${_reply:-Y}" in
    [Nn]*) _warn "skipping gh auth — gh CLI will be unauthenticated inside the container."; return 0 ;;
  esac

  if command -v gh >/dev/null 2>&1; then
    gh auth login || _warn "gh auth login did not complete — gh will be unauthenticated in the container."
  else
    echo "gdsa: gh not found on host — running 'gh auth login' inside the container (credentials will persist to ~/.config/gh/)."
    "$RUNTIME" run --rm -it \
      -v "$HOME/.config/gh:${CONTAINER_HOME}/.config/gh" \
      "$IMAGE" \
      gh auth login || _warn "gh auth login did not complete — gh will be unauthenticated in the container."
  fi
}

_preflight_opencode() {
  if [ ! -d "$HOME/.local/share/opencode" ]; then
    _warn "no opencode state at ~/.local/share/opencode/ — first run will initialize it."
    _hint "the keep-alive loop reads model state from this dir; it'll work once opencode writes there."
  fi
  _ensure_gh_auth
}

_preflight_copilot() {
  if [ ! -d "$HOME/.copilot" ]; then
    _warn "no Copilot CLI state at ~/.copilot/ — first run will prompt you to log in."
    _hint "auth and settings persist to ~/.copilot/ across container runs."
  fi
  _ensure_gh_auth
}

# Resolve a hostname to an IP via whatever the host has handy.
_resolve_host() {
  local host="$1" ip=""
  # Already a literal IPv4 address — nothing to resolve.
  if [[ "$host" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    echo "$host"
    return 0
  fi
  if command -v getent >/dev/null 2>&1; then
    ip=$(getent hosts "$host" 2>/dev/null | awk '{print $1; exit}')
    [ -n "$ip" ] && { echo "$ip"; return 0; }
  fi
  if command -v dscacheutil >/dev/null 2>&1; then
    ip=$(dscacheutil -q host -a name "$host" 2>/dev/null \
         | awk '/^ip_address:/ {print $2; exit}')
    [ -n "$ip" ] && { echo "$ip"; return 0; }
  fi
  if command -v dig >/dev/null 2>&1; then
    ip=$(dig +short "$host" 2>/dev/null | awk '/^[0-9.]+$/ {print; exit}')
    [ -n "$ip" ] && { echo "$ip"; return 0; }
  fi
  if command -v host >/dev/null 2>&1; then
    ip=$(host "$host" 2>/dev/null | awk '/has address/ {print $NF; exit}')
    [ -n "$ip" ] && { echo "$ip"; return 0; }
  fi
  return 1
}

ADD_HOSTS=()
_ADDED_HOST_ALIASES=()
_add_host_dedup() {
  local alias="$1" target="$2" a
  for a in ${_ADDED_HOST_ALIASES[@]+"${_ADDED_HOST_ALIASES[@]}"}; do
    [ "$a" = "$alias" ] && return 0
  done
  ADD_HOSTS+=(--add-host "${alias}:${target}")
  _ADDED_HOST_ALIASES+=("$alias")
}

# Resolves a bare "host:port" endpoint (as used for OLLAMA_HOST/OPENAI_HOST)
# for use inside the container: prints the host:port value the container
# should actually be given (stdout), and appends the matching --add-host
# entry to ADD_HOSTS as a side effect.
#
# localhost/127.0.0.1 is a special case: inside the container that address
# means the container itself, not the host that started it, so a resolved
# 127.0.0.1 would silently point opencode at nothing. Route those through
# the container runtime's host-gateway alias instead (host.docker.internal
# for docker, host.containers.internal for podman -- podman auto-injects
# this for rootless containers on some versions, but the explicit
# --add-host ...:host-gateway entry below is added regardless so this
# works the same across podman versions/network backends).
#
# A real hostname (including Tailscale MagicDNS names) is still resolved
# to a literal IP and pinned via --add-host, unchanged from before.
_resolve_endpoint() {
  local hostport="$1"
  local stripped hostname port
  stripped=$(echo "$hostport" | sed -E 's|^https?://||; s|/$||')
  hostname="${stripped%%:*}"
  port="${stripped#*:}"

  if [ "$hostname" = "localhost" ] || [[ "$hostname" =~ ^127(\.[0-9]{1,3}){3}$ ]]; then
    local alias
    case "$RUNTIME" in
      docker) alias="host.docker.internal" ;;
      *)      alias="host.containers.internal" ;;
    esac
    echo "gdsa: ${hostname} is loopback -- routing into the container via ${alias} (host-gateway)" >&2
    _add_host_dedup "$alias" "host-gateway"
    echo "${alias}:${port}"
    return 0
  fi

  local ip
  ip=$(_resolve_host "$hostname") || return 1
  echo "gdsa: resolved $hostname -> $ip" >&2
  _add_host_dedup "$hostname" "$ip"
  echo "$hostport"
}

#--- Subcommands --------------------------------------------------------------

_cmd_claude() {
  _parse_agent_opts "$@"
  local path="$AGENT_PATH"
  [ -d "$path" ] || _die "not a directory: $path"

  _preflight_common
  _preflight_claude

  _mount_common
  mkdir -p "$HOME/.claude"
  touch "$HOME/.claude.json"
  _mount_if_exists "$HOME/.claude"      "${CONTAINER_HOME}/.claude"      rw
  # Shadow the host's settings.json: it may carry a host-only PATH override
  # that doesn't resolve in the container and clobbers the image's baked
  # PATH. Mounted after the broader ~/.claude mount above so it takes
  # precedence for this one file.
  _mount_if_exists "${SCRIPT_DIR}/../frontend_agent/claude-settings.json" "${CONTAINER_HOME}/.claude/settings.json" ro
  _mount_if_exists "$HOME/.claude.json" "${CONTAINER_HOME}/.claude.json" rw
  _mount_git_creds

  _env_if_set ANTHROPIC_API_KEY

  "$RUNTIME" run --rm -it \
    -v "${path}:${WORKDIR}" \
    -w "${WORKDIR}" \
    ${MOUNTS[@]+"${MOUNTS[@]}"} \
    ${ENVS[@]+"${ENVS[@]}"} \
    "$IMAGE" \
    claude --dangerously-skip-permissions
}

_cmd_copilot() {
  _parse_agent_opts "$@"
  local path="$AGENT_PATH"
  [ -d "$path" ] || _die "not a directory: $path"

  _preflight_common
  _preflight_copilot

  _mount_common
  mkdir -p "$HOME/.copilot"
  _mount_if_exists "$HOME/.copilot" "${CONTAINER_HOME}/.copilot" rw
  _mount_git_creds
  for v in $(env | awk -F= '/^COPILOT_/{print $1}'); do
    ENVS+=(-e "$v")
  done

  "$RUNTIME" run --rm -it \
    -v "${path}:${WORKDIR}" \
    -w "${WORKDIR}" \
    ${MOUNTS[@]+"${MOUNTS[@]}"} \
    ${ENVS[@]+"${ENVS[@]}"} \
    "$IMAGE" \
    copilot --allow-all
}

_cmd_opencode() {
  _parse_agent_opts "$@"
  local path="$AGENT_PATH"
  [ -d "$path" ] || _die "not a directory: $path"

  _preflight_common
  _preflight_opencode

  # Resolve Ollama endpoint: env wins, else provider-url.txt next to script.
  # Resolve OpenAI-compatible endpoint the same way, independently -- may be
  # a different machine, or entirely absent; unlike Ollama it's normal for
  # this to be unset. At least one of the two must resolve.
  local ollama_host="${OLLAMA_HOST:-}"
  if [ -z "$ollama_host" ] && [ -f "${SCRIPT_DIR}/provider-url.txt" ]; then
    ollama_host=$(cat "${SCRIPT_DIR}/provider-url.txt")
  fi
  local openai_host="${OPENAI_HOST:-}"
  if [ -z "$openai_host" ] && [ -f "${SCRIPT_DIR}/openai-provider-url.txt" ]; then
    openai_host=$(cat "${SCRIPT_DIR}/openai-provider-url.txt")
  fi
  if [ -z "$ollama_host" ] && [ -z "$openai_host" ]; then
    _die "no OLLAMA_HOST or OPENAI_HOST set (and no provider-url.txt/openai-provider-url.txt next to gdsa). Set at least one."
  fi

  # _resolve_endpoint prints the host:port value to actually hand the
  # container (rewritten for loopback, see its definition) and appends the
  # matching --add-host entry to ADD_HOSTS as a side effect.
  local ollama_host_in_container="" openai_host_in_container=""
  if [ -n "$ollama_host" ]; then
    ollama_host_in_container=$(_resolve_endpoint "$ollama_host") || \
      _die "could not resolve the host in OLLAMA_HOST=$ollama_host — check DNS / VPN"
  fi
  if [ -n "$openai_host" ]; then
    openai_host_in_container=$(_resolve_endpoint "$openai_host") || \
      _die "could not resolve the host in OPENAI_HOST=$openai_host — check DNS / VPN"
  fi

  _mount_common
  _mount_if_exists "$HOME/.local/share/opencode"                       "${CONTAINER_HOME}/.local/share/opencode"           rw
  _mount_if_exists "${SCRIPT_DIR}/../frontend_agent/opencode.json"     "${CONTAINER_HOME}/.config/opencode/opencode.json"  ro
  _mount_if_exists "$HOME/.config/opencode/tui.json"                   "${CONTAINER_HOME}/.config/opencode/tui.json"       rw
  _mount_git_creds

  [ -n "$ollama_host_in_container" ] && ENVS+=(-e "OLLAMA_HOST=${ollama_host_in_container}")
  [ -n "$openai_host_in_container" ] && ENVS+=(-e "OPENAI_HOST=${openai_host_in_container}")
  ENVS+=(-e "GLAMOUR_STYLE=dark")

  # Pass opencode config as content env var — reliable fallback when the file
  # mount above fails. OPENCODE_CONFIG_CONTENT is merged last by opencode and
  # wins over the baked config.
  local _oc_json="${SCRIPT_DIR}/../frontend_agent/opencode.json"
  if [ -f "$_oc_json" ]; then
    export OPENCODE_CONFIG_CONTENT
    OPENCODE_CONFIG_CONTENT=$(cat "$_oc_json")
    ENVS+=(-e "OPENCODE_CONFIG_CONTENT")
  fi

  # Keep-alive (Ollama only): re-read the active model and ping Ollama every
  # 4 min so the model stays warm. Runs as a host-side background loop, so
  # it uses the original (unrewritten) $ollama_host -- it's hitting Ollama
  # directly from the host, not from inside the container. Registered with
  # the script-wide cleanup trap instead of setting its own.
  if [ -n "$ollama_host" ]; then
    local ollama_base state_file
    ollama_base="${ollama_host%/v1}"
    state_file="$HOME/.local/share/opencode/model.json"

    _keepalive() {
      while true; do
        sleep 240
        local model=""
        if [ -f "$state_file" ] && command -v jq >/dev/null 2>&1; then
          model=$(jq -r '.recent[0].modelID // empty' "$state_file" 2>/dev/null || true)
        fi
        if [ -n "$model" ]; then
          curl -s -o /dev/null -X POST "${ollama_base}/api/generate" \
            -H "Content-Type: application/json" \
            -d "{\"model\": \"${model}\", \"keep_alive\": \"5m\"}" || true
        fi
      done
    }
    _keepalive &
    CLEANUP_PIDS+=("$!")
  fi

  "$RUNTIME" run --rm -it \
    ${ADD_HOSTS[@]+"${ADD_HOSTS[@]}"} \
    -v "${path}:${WORKDIR}" \
    -w "${WORKDIR}" \
    ${MOUNTS[@]+"${MOUNTS[@]}"} \
    ${ENVS[@]+"${ENVS[@]}"} \
    "$IMAGE" \
    opencode
}

_cmd_shell() {
  local path="${1:-$PWD}"
  [ -d "$path" ] || _die "not a directory: $path"

  _preflight_common

  # No harness is running here, so the "untrusted agent" argument does not
  # apply -- you are the one at the keyboard.
  WITH_GIT_CREDS=1
  _mount_common

  "$RUNTIME" run --rm -it \
    -v "${path}:${WORKDIR}" \
    -w "${WORKDIR}" \
    ${MOUNTS[@]+"${MOUNTS[@]}"} \
    "$IMAGE" \
    bash
}

_cmd_update() {
  local target="${BASH_SOURCE[0]}"
  while [ -L "$target" ]; do
    local link
    link="$(readlink "$target")"
    [[ $link != /* ]] && link="$(dirname "$target")/$link"
    target="$link"
  done
  _die "gdsa update is not wired up for this repo yet -- pull the repo instead (git -C \"$(dirname "$target")\" pull)."
}

#--- Dispatch -----------------------------------------------------------------

case "${1:-help}" in
  claude)   shift; _cmd_claude   "$@" ;;
  opencode) shift; _cmd_opencode "$@" ;;
  copilot)  shift; _cmd_copilot  "$@" ;;
  shell)    shift; _cmd_shell    "$@" ;;
  update)   shift; _cmd_update   "$@" ;;
  help|-h|--help) _usage ;;
  *) _usage; exit 1 ;;
esac
